{
  "name": "remotion-photo-replica",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.500",
    "@remotion/media": "4.0.500",
    "@remotion/tailwind-v4": "4.0.500",
    "@remotion/zod-types": "^4.0.500",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.500",
    "tailwindcss": "4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.500",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "test": "vitest run",
    "test:fidelity": "vitest run --config vitest.fidelity.config.ts",
    "typecheck": "tsc --noEmit",
    "render:fidelity:safe": "remotion render --concurrency=1",
    "studio": "remotion studio",
    "render:check": "remotion still PhotoReplica out/check-115.png --frame=115",
    "render:video": "remotion render PhotoReplica out/photo-shot-replica.mp4 --muted --overwrite",
    "render:equity-check": "remotion still OpenAIEquitySplit out/equity-check-100.png --frame=100",
    "render:equity-video": "remotion render OpenAIEquitySplit out/openai-equity-split.mp4 --muted --overwrite",
    "render:brand-check": "remotion still AIBrandCardComparison out/brand-card-check-36.png --frame=36",
    "render:brand-video": "remotion render AIBrandCardComparison out/ai-brand-card-comparison.mp4 --muted --overwrite",
    "render:icon-check": "remotion still AIIconCloud out/icon-cloud-check-72.png --frame=72",
    "render:icon-video": "remotion render AIIconCloud out/ai-icon-cloud.mp4 --muted --overwrite",
    "render:sop-check": "remotion still ProductSOPPanel out/product-sop-check-58.png --frame=58",
    "render:sop-video": "remotion render ProductSOPPanel out/product-sop-panel.mp4 --muted --overwrite",
    "render:headline-check": "remotion still AIUsageHeadline out/ai-usage-headline-check-100.png --frame=100",
    "render:headline-video": "remotion render AIUsageHeadline out/ai-usage-headline.mp4 --muted --overwrite",
    "render:batch4": "remotion render BilateralAIIconStacks out/bilateral-ai-icon-stacks.mp4 --muted --overwrite",
    "render:batch5": "remotion render TraeLogoCallout out/trae-logo-callout.mp4 --muted --overwrite",
    "render:batch6": "remotion render ClaudeCodexComparison out/claude-codex-comparison.mp4 --muted --overwrite",
    "render:batch7": "remotion render PromptDocumentSplit out/prompt-document-split.mp4 --muted --overwrite",
    "render:batch8": "remotion render Aroll011DocumentSlide out/a-roll-011-document-slide.mp4 --muted --overwrite",
    "render:batch9": "remotion render Aroll012MilestoneCounter out/a-roll-012-milestone-counter.mp4 --muted --overwrite",
    "render:batch10": "remotion render Aroll013BossLevelCards out/a-roll-013-boss-level-cards.mp4 --muted --overwrite",
    "render:batch11": "remotion render Aroll014IterationGrowth out/a-roll-014-iteration-growth.mp4 --muted --overwrite",
    "render:batch12": "remotion render Aroll015KnowledgeCommodity out/a-roll-015-knowledge-commodity.mp4 --muted --overwrite",
    "render:batch13": "remotion render Aroll017AgentCardSwap out/a-roll-017-agent-card-swap.mp4 --muted --overwrite",
    "render:batch14": "remotion render Aroll018NumberedList out/a-roll-018-numbered-list.mp4 --muted --overwrite",
    "render:batch15": "remotion render Aroll019WorkflowSwap out/a-roll-019-workflow-swap.mp4 --muted --overwrite",
    "render:batch16": "remotion render Aroll020AITitleBuild out/a-roll-020-ai-title-build.mp4 --muted --overwrite",
    "render:batch17": "remotion render Aroll021AIClaims out/a-roll-021-ai-claims.mp4 --muted --overwrite",
    "render:batch19": "remotion render Aroll016PatientOutcome out/a-roll-016-patient-outcome.mp4 --muted --overwrite"
  },
  "sideEffects": [
    "*.css"
  ]
}
