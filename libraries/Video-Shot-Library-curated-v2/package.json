{
  "name": "video-shotcraft-local-library",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./shot-runtime": "./shot-runtime/index.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "data:build": "node scripts/build-library-data.mjs",
    "data:check": "node scripts/build-library-data.mjs --check",
    "graded:import": "node scripts/import-graded-libraries.mjs",
    "players:manifest": "node scripts/player-manifests.mjs",
    "players:build": "node scripts/build-players.mjs",
    "curated:check": "node scripts/curated-quality-check.mjs",
    "prebuild": "npm run data:build && npm run players:build",
    "test:data": "node --test tests/library-data.test.mjs tests/library-ui-model.test.mjs tests/graded-library.test.mjs tests/player-manifest.test.mjs tests/shot-categories.test.mjs tests/shot-metadata.test.mjs tests/shot-runtime-core.test.mjs tests/shot-runtime-registry.test.mjs tests/curated-v2-schema.test.mjs",
    "test": "npm run data:check && npm run build && npm run test:data && node --test tests/rendered-html.test.mjs",
    "lint": "eslint app worker db build scripts tests vite.config.ts next.config.ts drizzle.config.ts eslint.config.mjs postcss.config.mjs",
    "typegen": "CI=1 wrangler types --include-env=false",
    "typecheck": "npm run typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@paper-design/shaders-react": "^0.0.76",
    "@remotion/google-fonts": "^4.0.499",
    "@remotion/paths": "^4.0.499",
    "@remotion/player": "^4.0.499",
    "@remotion/transitions": "^4.0.499",
    "@uidotdev/usehooks": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "culori": "^4.0.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "0.45.2",
    "fumadocs-ui": "^16.7.10",
    "jotai": "^2.19.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.40.0",
    "next": "16.2.12",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.9.0",
    "remotion": "^4.0.499",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.182.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/culori": "^4.0.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "shadcn": "^4.11.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module"
}
