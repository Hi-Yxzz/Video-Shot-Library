{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": [
      "./worker-configuration.d.ts",
      "node",
      "react",
      "react-dom"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "remotion-bits": ["./library-sources/remotion-bits/src/index.ts"],
      "@/lib/remocn-icons": ["./library-sources/remocn/registry/remocn-icons/icons-core/index.ts"],
      "@/lib/remocn-ui": ["./library-sources/remocn/registry/remocn-ui/core/index.ts"],
      "@/lib/remocn-ui/*": ["./library-sources/remocn/registry/remocn-ui/core/*"],
      "@/lib/remocn/stop-motion": ["./library-sources/remocn/registry/remocn/stop-motion/index.ts"],
      "@/lib/remocn/scene-motion": ["./library-sources/remocn/registry/remocn/scene-motion/index.ts"],
      "@/components/remocn/brush": ["./library-sources/remocn/registry/remocn/brush/index.tsx"],
      "@/components/remocn/handwrite": ["./library-sources/remocn/registry/remocn/handwrite/index.tsx"],
      "@/components/remocn/use-cursor-path": ["./library-sources/remocn/registry/remocn-ui/cursor/use-cursor-path.ts"],
      "@/components/remocn/use-button-transition": ["./library-sources/remocn/registry/remocn-ui/button/use-button-transition.ts"],
      "@/components/remocn/use-input-transition": ["./library-sources/remocn/registry/remocn-ui/input/use-input-transition.ts"],
      "@/components/remocn/use-checkbox-transition": ["./library-sources/remocn/registry/remocn-ui/checkbox/use-checkbox-transition.ts"],
      "@/components/remocn/use-toast-transition": ["./library-sources/remocn/registry/remocn-ui/toast/use-toast-transition.ts"],
      "@/components/remocn/use-skeleton-transition": ["./library-sources/remocn/registry/remocn-ui/skeleton/use-skeleton-transition.ts"],
      "@/components/remocn/use-toggle-group-transition": ["./library-sources/remocn/registry/remocn-ui/toggle-group/use-toggle-group-transition.ts"],
      "@/components/remocn/use-dialog-transition": ["./library-sources/remocn/registry/remocn-ui/dialog/use-dialog-transition.ts"],
      "@/components/remocn/use-radio-transition": ["./library-sources/remocn/registry/remocn-ui/radio/use-radio-transition.ts"],
      "@/components/remocn/use-stepper-transition": ["./library-sources/remocn/registry/remocn-ui/stepper/use-stepper-transition.ts"],
      "@/components/remocn/use-switch-transition": ["./library-sources/remocn/registry/remocn-ui/switch/use-switch-transition.ts"],
      "@/components/remocn/use-select-transition": ["./library-sources/remocn/registry/remocn-ui/select/use-select-transition.ts"],
      "@/components/remocn/use-select-item-transition": ["./library-sources/remocn/registry/remocn-ui/select-item/use-select-item-transition.ts"],
      "@/components/remocn/use-slider-transition": ["./library-sources/remocn/registry/remocn-ui/slider/use-slider-transition.ts"],
      "@/components/remocn/use-blur-in-transition": ["./library-sources/remocn/registry/remocn-ui/blur-in/use-blur-in-transition.ts"],
      "@/components/remocn/use-message-bubble-transition": ["./library-sources/remocn/registry/remocn-ui/message-bubble/use-message-bubble-transition.ts"],
      "@/components/remocn/confetti": ["./library-sources/remocn/registry/remocn/confetti/index.tsx"],
      "@/components/remocn/glass-code-block": ["./library-sources/remocn/registry/remocn/glass-code-block/index.tsx"],
      "@/components/remocn/number-wheel": ["./library-sources/remocn/registry/remocn/number-wheel/index.tsx"],
      "@/components/remocn/terminal-simulator": ["./library-sources/remocn/registry/remocn/terminal-simulator/index.tsx"],
      "@/components/remocn/soft-blur-in": ["./library-sources/remocn/registry/remocn/soft-blur-in/index.tsx"],
      "@/components/remocn/blur-out-up": ["./library-sources/remocn/registry/remocn/blur-out-up/index.tsx"],
      "@/components/remocn/kinetic-center-build": ["./library-sources/remocn/registry/remocn/kinetic-center-build/index.tsx"],
      "@/components/remocn/per-character-rise": ["./library-sources/remocn/registry/remocn/per-character-rise/index.tsx"],
      "@/components/remocn/per-word-crossfade": ["./library-sources/remocn/registry/remocn/per-word-crossfade/index.tsx"],
      "@/components/remocn/staggered-fade-up": ["./library-sources/remocn/registry/remocn/staggered-fade-up/index.tsx"],
      "@/components/remocn/marker-highlight": ["./library-sources/remocn/registry/remocn/marker-highlight/index.tsx"],
      "@/components/remocn/micro-scale-fade": ["./library-sources/remocn/registry/remocn/micro-scale-fade/index.tsx"],
      "@/components/remocn/mask-reveal-up": ["./library-sources/remocn/registry/remocn/mask-reveal-up/index.tsx"],
      "@/components/remocn/tracking-in": ["./library-sources/remocn/registry/remocn/tracking-in/index.tsx"],
      "@/components/remocn/shader-swirl": ["./library-sources/remocn/registry/remocn/shader-swirl/index.tsx"],
      "@/components/remocn/shader-dithering": ["./library-sources/remocn/registry/remocn/shader-dithering/index.tsx"],
      "@/components/remocn/shader-perlin-noise": ["./library-sources/remocn/registry/remocn/shader-perlin-noise/index.tsx"],
      "@/components/remocn/shader-smoke-ring": ["./library-sources/remocn/registry/remocn/shader-smoke-ring/index.tsx"],
      "@/components/remocn/shader-grain-gradient": ["./library-sources/remocn/registry/remocn/shader-grain-gradient/index.tsx"],
      "@/components/remocn/shader-warp": ["./library-sources/remocn/registry/remocn/shader-warp/index.tsx"],
      "@/components/remocn/ascii-dissolve": ["./library-sources/remocn/registry/remocn/ascii-dissolve/index.tsx"],
      "@/components/remocn/caret-wipe": ["./library-sources/remocn/registry/remocn/caret-wipe/index.tsx"],
      "@/components/remocn/icon-scatter": ["./library-sources/remocn/registry/remocn/icon-scatter/index.tsx"],
      "@/components/remocn/shader-caustics": ["./library-sources/remocn/registry/remocn/shader-caustics/index.tsx"],
      "@/components/remocn/shader-gem-smoke": ["./library-sources/remocn/registry/remocn/shader-gem-smoke/index.tsx"],
      "@/components/remocn/shader-strata": ["./library-sources/remocn/registry/remocn/shader-strata/index.tsx"],
      "@/components/remocn/shader-weave": ["./library-sources/remocn/registry/remocn/shader-weave/index.tsx"],
      "@/components/remocn/reel": ["./library-sources/remocn/registry/remocn/reel/index.tsx"],
      "@/components/remocn/*": ["./library-sources/remocn/registry/remocn-ui/*/index.tsx"],
      "@/*": ["./*", "./library-sources/remocn/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "worker-configuration.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "worker/**/*.ts",
    "db/**/*.ts",
    "build/**/*.ts",
    "shot-runtime/**/*.ts",
    "tests/**/*.mjs",
    "vite.config.ts",
    "next.config.ts",
    "drizzle.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "demos",
    "references",
    "docs",
    "examples"
  ]
}
